---
interface Props {
  /** Base URL for links (e.g. https://threepiece.us) */
  baseUrl?: string;
}

import { getNavItems } from '../lib/nav-items';

const { baseUrl = 'https://threepiece.us' } = Astro.props;
const logoUrl = 'https://cdn11.bigcommerce.com/s-8zxb6tk/images/stencil/200x90/threepiece-logo_1713917723__25054.original.png';

const navItems = await getNavItems(baseUrl);
---

<header class="site-header">
  <!-- Desktop: two rows -->
  <div class="site-header__top site-header__top--desktop">
    <div class="site-header__inner">
      <div class="site-header__brand">
        <button type="button" class="site-header__desktop-hamburger" aria-label="Show navigation" id="header-desktop-hamburger">
          <span class="site-header__hamburger-line"></span>
          <span class="site-header__hamburger-line"></span>
          <span class="site-header__hamburger-line"></span>
        </button>
        <a href={baseUrl} class="site-header__logo">
          <img src={logoUrl} alt="threepiece.us" class="site-header__logo-img" width="200" height="90" />
        </a>
      </div>

      <form class="site-header__search" role="search" aria-label="Site search" id="header-search-form">
        <label class="visually-hidden" for="header-search-query">Search</label>
        <span class="site-header__search-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </span>
        <input
          id="header-search-query"
          class="site-header__search-input"
          type="search"
          name="search_query"
          placeholder="What are you looking for?"
          autocomplete="off"
          aria-autocomplete="list"
          aria-controls="header-search-dropdown"
          aria-expanded="false"
        />
        <button type="button" class="site-header__search-clear" id="header-search-clear" hidden>Clear</button>
        <div
          class="site-header__search-dropdown"
          id="header-search-dropdown"
          role="listbox"
          aria-label="Search suggestions"
          hidden
        ></div>
      </form>

      <div class="site-header__utils">
        <a
          href="https://www.threepiece.us/compare"
          class="site-header__util site-header__util--compare"
          aria-label="Compare products (placeholder)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="M3 9h18M3 13h18M3 17h18" />
          </svg>
          <span class="site-header__util-count">(2)</span>
        </a>

        <span class="site-header__util-divider" aria-hidden="true"></span>

        <div class="site-header__util site-header__util--account">
          <a href="https://www.threepiece.us/login.php" class="site-header__util-link" aria-label="Sign in">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Sign in</span>
          </a>
          <a href="https://www.threepiece.us/login.php?action=create_account" class="site-header__util-link">Register</a>
        </div>

        <span class="site-header__util-divider" aria-hidden="true"></span>

        <a
          href="https://www.threepiece.us/cart.php"
          class="site-header__util site-header__util--cart"
          aria-label="Cart with 0 items"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 7h15l-1.4 8.2a1.5 1.5 0 0 1-1.5 1.3H8.4a1.5 1.5 0 0 1-1.5-1.2L5.2 4.5A1 1 0 0 0 4.2 3.7H2" />
            <circle cx="9.5" cy="20" r="1" />
            <circle cx="17.5" cy="20" r="1" />
          </svg>
          <span class="site-header__util-count">(0)</span>
        </a>
      </div>
    </div>
  </div>
  <div class="site-header__nav-wrap">
    <div class="site-header__inner">
    <nav class="site-header__nav site-header__nav--desktop" aria-label="Main navigation">
      {navItems.map((item) => (
        <div class="site-header__nav-item">
          <a href={item.href} class="site-header__nav-link">{item.name}</a>
          {item.children.length > 0 && (
            <div class="site-header__mega" aria-hidden="true">
              <div class="site-header__mega-inner">
                <p class="site-header__mega-title">{item.name}</p>
                <a href={item.href} class="site-header__mega-view-all">View all {item.name}</a>
                <ul class="site-header__mega-list" aria-label={`Categories under ${item.name}`}>
                  {item.children.map((child) => (
                    <li class={`site-header__mega-list-item${child.children.length > 0 ? ' site-header__mega-list-item--has-sub' : ''}`}>
                      <a href={child.href} class="site-header__mega-link">{child.name}</a>
                      {child.children.length > 0 && (
                        <ul class="site-header__mega-sublist">
                          {child.children.map((sub) => (
                            <li><a href={sub.href} class="site-header__mega-sublink">{sub.name}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>
    </div>
  </div>

  <!-- Mobile: single bar with hamburger, logo, icons -->
  <div class="site-header__mobile">
    <button type="button" class="site-header__hamburger" aria-label="Open menu" aria-expanded="false" id="header-hamburger">
      <span class="site-header__hamburger-line"></span>
      <span class="site-header__hamburger-line"></span>
      <span class="site-header__hamburger-line"></span>
    </button>
    <a href={baseUrl} class="site-header__logo site-header__logo--mobile">
      <img src={logoUrl} alt="threepiece.us" class="site-header__logo-img" width="200" height="90" />
    </a>
    <div class="site-header__mobile-actions">
      <a
        href="https://www.threepiece.us/compare"
        class="site-header__mobile-action site-header__mobile-action--garage"
        aria-label="Compare vehicles (2)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1.5" />
          <path d="M3 9h18M3 13h18M3 17h18" />
        </svg>
        <span class="site-header__util-count">(2)</span>
      </a>
      <button type="button" class="site-header__mobile-action site-header__mobile-action--search" id="header-mobile-search-open" aria-label="Open search">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile search modal -->
  <div class="site-header__search-modal" id="header-search-modal" hidden aria-hidden="true">
    <div class="site-header__search-modal-panel">
      <h2 class="site-header__search-modal-title">SEARCH</h2>
      <form class="site-header__search-modal-form" id="header-mobile-search-form" role="search">
        <div class="site-header__search-modal-field">
          <input
            id="header-mobile-search-query"
            class="site-header__search-modal-input"
            type="search"
            name="search_query"
            placeholder="What are you looking for?"
            autocomplete="off"
          />
          <button type="button" class="site-header__search-clear" id="header-mobile-search-clear" hidden>Clear</button>
        </div>
        <button type="submit" class="site-header__search-modal-submit" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>
      </form>
      <div class="site-header__search-modal-results" id="header-mobile-search-results"></div>
    </div>
  </div>

  <!-- Mobile nav overlay -->
  <div class="site-header__overlay" id="header-overlay" aria-hidden="true">
    <div class="site-header__panel" id="header-panel">
      <button type="button" class="site-header__close" aria-label="Close menu" id="header-close">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <nav class="site-header__panel-nav" aria-label="Mobile navigation">
        <div class="site-header__panel-item site-header__panel-item--auth">
          <span class="site-header__panel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <a href="https://www.threepiece.us/login.php">SIGN IN</a><span class="site-header__auth-sep"> or </span><a href="https://www.threepiece.us/login.php?action=create_account">REGISTER</a>
        </div>
        {navItems.map((item) => {
          const hasSubmenus = item.children.some((c) => c.children.length > 0);
          const useCollapsible = item.children.length > 0 && hasSubmenus;
          return (
          <div class="site-header__panel-group">
            {item.children.length > 0 ? (
              useCollapsible ? (
                <>
                  <button type="button" class="site-header__panel-toggle" aria-expanded="false" data-panel-toggle>
                    <span>{item.name}</span>
                    <span class="site-header__panel-chevron site-header__panel-chevron--toggle" aria-hidden="true">&#x203A;</span>
                  </button>
                  <div class="site-header__panel-children" hidden>
                    <a href={item.href} class="site-header__panel-item site-header__panel-item--view-all">View all {item.name}</a>
                    {item.children.map((child) => (
                      <div class="site-header__panel-child-block">
                        {child.children.length > 0 ? (
                          <>
                            <button type="button" class="site-header__panel-item site-header__panel-item--child site-header__panel-sub-toggle" aria-expanded="false" data-panel-sub-toggle>
                              {child.name}
                              <span class="site-header__panel-chevron site-header__panel-chevron--sub" aria-hidden="true">&#x203A;</span>
                            </button>
                            <div class="site-header__panel-subchildren" hidden>
                              <a href={child.href} class="site-header__panel-item site-header__panel-item--view-all">View all {child.name}</a>
                              {child.children.map((sub) => (
                                <a href={sub.href} class="site-header__panel-item site-header__panel-item--subchild">{sub.name}</a>
                              ))}
                            </div>
                          </>
                        ) : (
                          <a href={child.href} class="site-header__panel-item site-header__panel-item--child">{child.name}</a>
                        )}
                      </div>
                    ))}
                  </div>
                </>
              ) : (
                <>
                  <a href={item.href} class="site-header__panel-item site-header__panel-item--parent">
                    {item.name}
                    <span class="site-header__panel-chevron">&#x203A;</span>
                  </a>
                  <div class="site-header__panel-children">
                    {item.children.map((child) => (
                      <div class="site-header__panel-child-block">
                        <a href={child.href} class="site-header__panel-item site-header__panel-item--child">{child.name}</a>
                      </div>
                    ))}
                  </div>
                </>
              )
            ) : (
              <a href={item.href} class="site-header__panel-item site-header__panel-item--parent">
                {item.name}
              </a>
            )}
          </div>
          );
        })}
      </nav>
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    width: 100%;
  }

  .site-header__inner {
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -ms-flex-flow: row nowrap;
    flex-flow: row nowrap;
    margin: 0 auto;
    max-width: 1230px;
    padding: 0 15px;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
  }

  /* Desktop top bar: full-bleed black, content capped at 1230px */
  .site-header__top--desktop {
    background-color: #000000;
    /* Match main site .header-logo--wrap */
    padding: 20px 0;
  }

  .site-header__top--desktop .site-header__inner {
    gap: 2rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    flex: 0 0 auto;
  }

  .site-header__desktop-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: #ffffff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    flex-shrink: 0;
  }

  .site-header__desktop-hamburger .site-header__hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
  }

  .site-header__search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: 1 1 auto;
    min-width: 0;
    height: 45px;
    padding: 0 1rem;
    border-radius: 3px;
    background: #ffffff;
    color: #6b6b6b;
  }

  .site-header__search-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #b0b0b0;
  }

  .site-header__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: #222;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .site-header__search-input::placeholder {
    color: #a3a3a3;
  }

  .site-header__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .site-header__search-clear {
    flex-shrink: 0;
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    color: #b0b0b0;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
  }

  .site-header__search-clear:hover {
    color: #666;
  }

  .site-header__search-dropdown {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    z-index: 1200;
    height: fit-content;
    overflow: visible;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-top: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    color: #222;
    text-align: left;
  }

  .site-header__search-section-title {
    margin: 0;
    padding: 0.55rem 1rem;
    background: #f0f0f0;
    color: #222;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .site-header__search-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__search-item {
    margin: 0;
    border-bottom: 1px solid #eee;
  }

  .site-header__search-item:last-child {
    border-bottom: none;
  }

  .site-header__search-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1rem;
    color: #222;
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .site-header__search-link:hover {
    background: #f7f7f7;
  }

  .site-header__search-link--text {
    display: block;
  }

  .site-header__search-thumb {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: #fff;
  }

  .site-header__search-thumb--product {
    border-radius: 50%;
  }

  .site-header__search-thumb--blog {
    border-radius: 2px;
  }

  .site-header__search-item-body {
    min-width: 0;
    flex: 1 1 auto;
  }

  .site-header__search-item-title {
    display: block;
    color: #222;
  }

  .site-header__search-item-price {
    display: block;
    margin-top: 0.15rem;
    color: #444;
    font-size: 0.875rem;
  }

  .site-header__search-footer {
    display: block;
    padding: 0.7rem 1rem;
    background: #f0f0f0;
    color: #222;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__search-footer:hover {
    background: #e8e8e8;
  }

  .site-header__search-empty {
    padding: 1rem;
    color: #666;
    font-size: 0.875rem;
    text-align: center;
  }

  .site-header__utils {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex: 0 0 auto;
    color: #ffffff;
  }

  .site-header__util {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1;
    white-space: nowrap;
  }

  .site-header__util-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  .site-header__util-link:hover {
    text-decoration: none;
  }

  .site-header__util--compare:hover,
  .site-header__util--cart:hover {
    text-decoration: none;
  }

  .site-header__util--account {
    gap: 0.65rem;
  }

  .site-header__util-count {
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .site-header__util-divider {
    width: 1px;
    height: 1.25rem;
    background: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Desktop nav wrapper for smooth collapse */
  .site-header__nav-wrap {
    overflow: visible;
    transition: max-height 0.35s ease;
    background-color: #1C1D21;
  }

  .site-header__nav-item:hover,
  .site-header__nav-item:focus-within {
    z-index: 110;
  }

  .site-header.is-scrolled .site-header__nav-wrap {
    overflow: hidden;
  }

  /* Desktop: when scrolled, collapse nav and show hamburger in top bar */
  @media (min-width: 901px) {
    .site-header__desktop-hamburger {
      display: flex;
      width: 44px;
    }
    .site-header:not(.is-scrolled) .site-header__desktop-hamburger {
      width: 0;
      min-width: 0;
      padding: 0;
      overflow: hidden;
    }
    .site-header.is-scrolled .site-header__desktop-hamburger {
      display: flex;
      opacity: 1;
      pointer-events: auto;
    }
    .site-header__nav-wrap {
      max-height: 100px;
    }
    .site-header.is-scrolled .site-header__nav-wrap {
      max-height: 0;
    }
  }

  .site-header__logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #ffffff;
  }

  .site-header__logo-img {
    display: block;
    height: auto;
    max-height: 45px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 901px) {
    .site-header__top--desktop .site-header__logo-img {
      height: 45px;
      width: 100px;
    }
  }

  .site-header__nav--desktop {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    padding: 0;
    flex-wrap: wrap;
    position: relative;
  }

  .site-header__nav-item {
    position: relative;
  }

  .site-header__nav-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    display: inline-block;
    /* Match main site .navPages-action vertical rhythm */
    padding: 15px 1.14286rem;
  }

  .site-header__nav-item:first-child .site-header__nav-link {
    padding-left: 0;
  }

  .site-header__nav-link:hover {
    text-decoration: underline;
  }

  /* Mega menu - opens on hover of nav item */
  .site-header__mega {
    position: absolute;
    left: 0;
    top: 100%;
    min-width: 220px;
    padding-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 100;
  }

  .site-header__nav-item:hover .site-header__mega,
  .site-header__nav-item:focus-within .site-header__mega {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-header__mega-inner {
    background: #1a1a1a;
    border-radius: 4px;
    padding: 1rem 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    border: 1px solid #333;
    overflow: visible;
  }

  .site-header__mega-title {
    margin: 0 0 0.5rem;
    padding: 0 1.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #fff;
    border-bottom: 1px solid #333;
  }

  .site-header__mega-view-all {
    display: block;
