<script is:inline>
  function initSiteHeader() {
    var header = document.querySelector('.site-header');
    var hamburger = document.getElementById('header-hamburger');
    var desktopHamburger = document.getElementById('header-desktop-hamburger');
    var overlay = document.getElementById('header-overlay');
    var closeBtn = document.getElementById('header-close');
    var thresholdHide = 80;
    var thresholdShow = 35;
    var navManuallyOpened = false;
    var lastManualOpenTime = 0;
    var openDebounceMs = 400;

    function isDesktop() {
      return window.matchMedia('(min-width: 901px)').matches;
    }

    function updateScrolled() {
      if (!header || !isDesktop()) return;
      var y = window.scrollY;
      if (y <= thresholdShow) {
        navManuallyOpened = false;
        header.classList.remove('is-scrolled');
        return;
      }
      if (y < thresholdHide) return;
      if (navManuallyOpened && (Date.now() - lastManualOpenTime < openDebounceMs)) return;
      navManuallyOpened = false;
      header.classList.add('is-scrolled');
    }

    if (header && desktopHamburger && !desktopHamburger.dataset.bound) {
      desktopHamburger.dataset.bound = 'true';
      window.addEventListener('scroll', updateScrolled, { passive: true });
      updateScrolled();
      desktopHamburger.addEventListener('click', function () {
        navManuallyOpened = true;
        lastManualOpenTime = Date.now();
        header.classList.remove('is-scrolled');
      });
    }

    if (!hamburger || !overlay || !closeBtn || overlay.dataset.bound) return;
    overlay.dataset.bound = 'true';

    function openMenu() {
      overlay.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      overlay.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    hamburger.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeMenu();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });

    var panel = document.getElementById('header-panel');
    if (panel && !panel.dataset.bound) {
      panel.dataset.bound = 'true';
      panel.addEventListener('click', function (e) {
        var subBtn = e.target.closest('[data-panel-sub-toggle]');
        if (subBtn) {
          e.preventDefault();
          var block = subBtn.closest('.site-header__panel-child-block');
          var subChildren = block && block.querySelector('.site-header__panel-subchildren');
          if (!block || !subChildren) return;
          var expanded = block.classList.toggle('is-expanded');
          subBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          if (expanded) {
            subChildren.removeAttribute('hidden');
          } else {
            subChildren.setAttribute('hidden', '');
          }
          return;
        }
        var btn = e.target.closest('[data-panel-toggle]');
        if (!btn) return;
        e.preventDefault();
        var group = btn.closest('.site-header__panel-group');
        var children = group && group.querySelector('.site-header__panel-children');
        if (!group || !children) return;
        var expanded = group.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        if (expanded) {
          children.removeAttribute('hidden');
        } else {
          children.setAttribute('hidden', '');
        }
      });
    }
  }

  initSiteHeader();
  document.addEventListener('astro:page-load', initSiteHeader);
</script>

<script is:inline>
  function initHeaderSearch() {
    var AUTOCOMPLETE_URL = 'https://threepieceus.myconvermax.com/autocomplete.json';
    var SEARCH_PAGE = 'https://www.threepiece.us/search/';
    var STORE_BASE = 'https://www.threepiece.us';
    var CDN_BASE = 'https://cdn11.bigcommerce.com/s-8zxb6tk';
    var DEBOUNCE_MS = 250;

    var form = document.getElementById('header-search-form');
    var input = document.getElementById('header-search-query');
    var clearBtn = document.getElementById('header-search-clear');
    var dropdown = document.getElementById('header-search-dropdown');
    var mobileOpen = document.getElementById('header-mobile-search-open');
    var modal = document.getElementById('header-search-modal');
    var mobileForm = document.getElementById('header-mobile-search-form');
    var mobileInput = document.getElementById('header-mobile-search-query');
    var mobileClear = document.getElementById('header-mobile-search-clear');
    var mobileResults = document.getElementById('header-mobile-search-results');

    if (!form || !input || !dropdown || form.dataset.searchBound === 'true') return;
    form.dataset.searchBound = 'true';

    var desktopTimer = null;
    var mobileTimer = null;
    var desktopRequestId = 0;
    var mobileRequestId = 0;
    var trendingCache = null;

    function toSearchQueryParam(text) {
      return String(text || '')
        .trim()
        .replace(/\s+/g, '-');
    }

    function buildSearchUrl(text) {
      return SEARCH_PAGE + '?query=' + encodeURIComponent(toSearchQueryParam(text));
    }

    function absoluteUrl(path) {
      if (!path) return '';
      if (/^https?:\/\//i.test(path)) return path;
      return STORE_BASE + (path.charAt(0) === '/' ? path : '/' + path);
    }

    function blogImageUrl(path) {
      if (!path) return '';
      if (/^https?:\/\//i.test(path)) return path;
      return CDN_BASE + (path.charAt(0) === '/' ? path : '/' + path);
    }

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function sanitizeHighlight(html) {
      var escaped = escapeHtml(String(html || '').replace(/<\/?b>/gi, function (tag) {
        return tag.toLowerCase() === '<b>' ? '[[B]]' : '[[/B]]';
      }));
      return escaped.replace(/\[\[B\]\]/g, '<b>').replace(/\[\[\/B\]\]/g, '</b>');
    }

    function formatPrice(price) {
      var n = Number(price);
      if (!isFinite(n)) return '';
      return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatHits(n) {
      return Number(n || 0).toLocaleString('en-US');
    }

    function groupItems(items) {
      var suggestions = [];
      var products = [];
      var blogs = [];
      var totalHits = 0;
      (items || []).forEach(function (item) {
        if (item.Type === 'PopularSearch') {
          suggestions.push(item);
        } else if (item.Type === 'Product' || item.SuggestionGroup === 'Products') {
          products.push(item);
          if (item.TotalHits && !totalHits) totalHits = item.TotalHits;
        } else if (item.SuggestionGroup === 'Blog') {
          blogs.push(item);
        }
      });
      return { suggestions: suggestions, products: products, blogs: blogs, totalHits: totalHits };
    }

    function renderSection(title, bodyHtml) {
      if (!bodyHtml) return '';
      return (
        '<div class="site-header__search-section">' +
        '<p class="site-header__search-section-title">' +
        escapeHtml(title) +
        '</p>' +
        bodyHtml +
        '</div>'
      );
    }

    function renderSuggestionList(items) {
      if (!items.length) return '';
      var html = '<ul class="site-header__search-list">';
      items.forEach(function (item) {
        var label = item.TextHighlight || item.Text || '';
        var text = item.Text || '';
        html +=
          '<li class="site-header__search-item">' +
          '<a class="site-header__search-link site-header__search-link--text" href="' +
          escapeHtml(buildSearchUrl(text)) +
          '">' +
          sanitizeHighlight(label) +
          '</a></li>';
      });
      html += '</ul>';
      return html;
    }

    function renderProductList(items) {
      if (!items.length) return '';
      var html = '<ul class="site-header__search-list">';
      items.forEach(function (item) {
        var href = absoluteUrl(item.custom_url);
        var img = item.image_standard || '';
        var title = item.name || '';
        var price = formatPrice(item.price);
        html +=
          '<li class="site-header__search-item">' +
          '<a class="site-header__search-link" href="' +
          escapeHtml(href) +
          '">' +
          (img
            ? '<img class="site-header__search-thumb site-header__search-thumb--product" src="' +
              escapeHtml(img) +
              '" alt="" width="48" height="48" loading="lazy" />'
            : '') +
          '<span class="site-header__search-item-body">' +
          '<span class="site-header__search-item-title">' +
          sanitizeHighlight(title) +
          '</span>' +
          (price ? '<span class="site-header__search-item-price">' + escapeHtml(price) + '</span>' : '') +
          '</span></a></li>';
      });
      html += '</ul>';
      return html;
    }

    function renderBlogList(items) {
      if (!items.length) return '';
      var html = '<ul class="site-header__search-list">';
      items.forEach(function (item) {
        var href = absoluteUrl(item.RedirectUrl);
        var img = blogImageUrl(item.ImageUrl);
        var title = item.Value || item.FacetValue || '';
        html +=
          '<li class="site-header__search-item">' +
          '<a class="site-header__search-link" href="' +
          escapeHtml(href) +
          '">' +
          (img
            ? '<img class="site-header__search-thumb site-header__search-thumb--blog" src="' +
              escapeHtml(img) +
              '" alt="" width="48" height="48" loading="lazy" />'
            : '') +
          '<span class="site-header__search-item-body">' +
          '<span class="site-header__search-item-title">' +
          escapeHtml(title) +
          '</span></span></a></li>';
      });
      html += '</ul>';
      return html;
    }

    function renderResults(items, query) {
      var q = String(query || '').trim();
      if (!q) {
        var trending = (items || []).filter(function (item) {
          return item.Type === 'PopularSearch';
        });
        if (!trending.length) {
          return '<p class="site-header__search-empty">No trending searches</p>';
        }
        return renderSection('TRENDING', renderSuggestionList(trending));
      }

      var grouped = groupItems(items);
      var html = '';
      html += renderSection('SUGGESTIONS', renderSuggestionList(grouped.suggestions));
      if (grouped.products.length) {
        html += renderSection(
          formatHits(grouped.totalHits) + ' PRODUCTS',
          renderProductList(grouped.products)
        );
      }
      html += renderSection('BLOG', renderBlogList(grouped.blogs));
      if (grouped.totalHits) {
        html +=
          '<a class="site-header__search-footer" href="' +
          escapeHtml(buildSearchUrl(q)) +
          '">Browse all ' +
          escapeHtml(formatHits(grouped.totalHits)) +
          ' products</a>';
      }
      if (!html) {
        return '<p class="site-header__search-empty">No results</p>';
      }
      return html;
    }

    function fetchAutocomplete(query) {
      var q = String(query || '').trim();
      if (!q && trendingCache) {
        return Promise.resolve(trendingCache);
      }
      var url = q ? AUTOCOMPLETE_URL + '?query=' + encodeURIComponent(q) : AUTOCOMPLETE_URL;
      return fetch(url, { credentials: 'omit' })
        .then(function (res) {
          if (!res.ok) throw new Error('Autocomplete failed');
          return res.json();
        })
        .then(function (data) {
          var items = Array.isArray(data) ? data : [];
          if (!q) trendingCache = items;
          return items;
        });
    }

    function setClearVisible(btn, value) {
      if (!btn) return;
      if (String(value || '').length) {
        btn.hidden = false;
      } else {
        btn.hidden = true;
      }
    }

    function openDropdown() {
      dropdown.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown() {
      dropdown.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    }

    function updateDesktop(query) {
      var requestId = ++desktopRequestId;
      fetchAutocomplete(query)
        .then(function (items) {
          if (requestId !== desktopRequestId) return;
          dropdown.innerHTML = renderResults(items, query);
          openDropdown();
        })
        .catch(function () {
          if (requestId !== desktopRequestId) return;
          dropdown.innerHTML = '<p class="site-header__search-empty">Search unavailable</p>';
          openDropdown();
        });
    }

    function updateMobile(query) {
      if (!mobileResults) return;
      var requestId = ++mobileRequestId;
      fetchAutocomplete(query)
        .then(function (items) {
          if (requestId !== mobileRequestId) return;
          mobileResults.innerHTML = renderResults(items, query);
        })
        .catch(function () {
          if (requestId !== mobileRequestId) return;
          mobileResults.innerHTML = '<p class="site-header__search-empty">Search unavailable</p>';
        });
    }

    function openMobileSearch() {
      if (!modal) return;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (mobileInput) {
        mobileInput.value = '';
        setClearVisible(mobileClear, '');
        updateMobile('');
        setTimeout(function () {
          mobileInput.focus();
        }, 50);
      }
    }

    function closeMobileSearch() {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var q = input.value.trim();
      if (!q) return;
      window.location.href = buildSearchUrl(q);
    });

    input.addEventListener('focus', function () {
      updateDesktop(input.value);
    });

    input.addEventListener('input', function () {
      setClearVisible(clearBtn, input.value);
      clearTimeout(desktopTimer);
      desktopTimer = setTimeout(function () {
        updateDesktop(input.value);
      }, DEBOUNCE_MS);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        input.value = '';
        setClearVisible(clearBtn, '');
        updateDesktop('');
        input.focus();
      });
    }

    document.addEventListener('click', function (e) {
      if (!dropdown.hidden && !form.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (!dropdown.hidden) {
        closeDropdown();
        input.blur();
      }
      closeMobileSearch();
    });

    if (mobileOpen) {
      mobileOpen.addEventListener('click', openMobileSearch);
    }

    if (mobileForm && mobileInput) {
      mobileForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var q = mobileInput.value.trim();
        if (!q) return;
        window.location.href = buildSearchUrl(q);
      });

      mobileInput.addEventListener('input', function () {
        setClearVisible(mobileClear, mobileInput.value);
        clearTimeout(mobileTimer);
        mobileTimer = setTimeout(function () {
          updateMobile(mobileInput.value);
        }, DEBOUNCE_MS);
      });
    }

    if (mobileClear && mobileInput) {
      mobileClear.addEventListener('click', function () {
        mobileInput.value = '';
        setClearVisible(mobileClear, '');
        updateMobile('');
        mobileInput.focus();
      });
    }

    setClearVisible(clearBtn, input.value);
  }

  initHeaderSearch();
  document.addEventListener('astro:page-load', initHeaderSearch);
</script>
